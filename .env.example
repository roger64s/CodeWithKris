# Supabase project settings. Never commit the real .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
API_PORT=8787

# Optional OpenAI-compatible speech-to-text endpoint. Audio history is still saved when omitted.
AI_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIPTION_API_KEY=your-server-only-transcription-key
AI_TRANSCRIPTION_MODEL=your-transcription-model

# Optional internal MFCC/MLP inference service. No classification result is shown when omitted.
ML_INFERENCE_API_URL=http://127.0.0.1:8001
ML_SERVICE_API_KEY=replace-with-a-long-random-server-only-key
ML_MODEL_ROOT=ml/artifacts
ML_DEFAULT_TASK_ID=appointment-fixing
